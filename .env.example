# Copy to .env for local development. Never commit .env.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# --- Database ----------------------------------------------------------------
POSTGRES_USER=meal
POSTGRES_PASSWORD=meal_dev_password
POSTGRES_DB=meal
# Local no-Docker database: `pnpm --filter @meal/api-legacy db:local` listens on 5433.
DATABASE_URL=postgresql://meal:meal_dev_password@localhost:5433/meal?schema=public

# --- API ---------------------------------------------------------------------
API_PORT=3001
# Public origin users type in the browser (same domain for web and /api).
APP_BASE_URL=http://localhost:8080
# Used to sign the short-lived OIDC state cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-change-me-dev-only
SESSION_TTL_HOURS=12
# Set true when served over HTTPS so the session cookie gets the Secure flag. Required in
# production: the api refuses to start without it, since the PIN must never travel over plain HTTP.
COOKIE_SECURE=false

# --- Clock -------------------------------------------------------------------
# Fake-time mode for tests and demos. Ignored (and rejected) when NODE_ENV=production.
CLOCK_FAKE_ENABLED=true

# --- Java API (apps/api) -------------------------------------------------------
# The Java API reads this same file (MEAL_ENV_FILE, set by `pnpm --filter @meal/api start:dev`).
# Its environment is APP_ENV when set, otherwise NODE_ENV (development | test | production).
# Development only: lets the Java API use a database the legacy API already migrated
# (`pnpm db:migrate`); Flyway then records V1..V3 as applied instead of running them. It has no
# effect on an empty database. Leave it unset (false) in production.
FLYWAY_BASELINE_ON_MIGRATE=true
# Port of the Java API on the host when started with `docker compose --profile java`.
API_JAVA_PORT=3002
# OpenAPI description at /api/openapi.json (the web's types are generated from it in J3).
# Development only; leave it unset (false) in production.
API_DOCS_ENABLED=true

# --- Background jobs (plan 6.5) -------------------------------------------------
# pg-boss scheduler (org sync 02:00, menu-publish warning hourly). Stored in the "pgboss" schema.
JOBS_ENABLED=true

# --- Entra ID SSO (plan section 5) --------------------------------------------
# mock = built-in fake Microsoft page (dev only); oidc = real Entra OIDC Authorization Code + PKCE
ENTRA_MODE=mock
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Must equal the redirect URI registered in the Entra app registration.
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback

# --- DMP (plan section 5) -----------------------------------------------------
# mock = MockDmpClient reading prisma seed scenarios; http = HttpDmpClient (needs a service account)
DMP_MODE=mock
DMP_MOCK_SCENARIO=on-time
DMP_BASE_URL=
DMP_SERVICE_EMAIL=
DMP_SERVICE_PASSWORD=
DMP_COMPANY_CODE=

# --- Seed (development only; the seed refuses to run when NODE_ENV=production) -----
# Initial PIN given to every seeded employee; they must change it at first sign-in.
SEED_INITIAL_PIN=123456
# Employee code of the first system admin (plan section 3: first one from an environment variable).
FIRST_SYSTEM_ADMIN_CODE=PNJP000004

# --- Web ---------------------------------------------------------------------
# Where the Next.js server reaches the API (server-side fetches and dev rewrites).
API_INTERNAL_URL=http://localhost:3001
WEB_PORT=3000
NGINX_PORT=8080
