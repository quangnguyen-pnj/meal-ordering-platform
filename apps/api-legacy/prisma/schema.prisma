// Schema from plan 6.3. P0: core and auth; P1: menu, registration shell, forecast snapshot shell,
// notifications and mapping imports. Later phases add attendance, finalization and delivery.
// Never delete business data: use status / active / archivedAt (plan 7.1 rule 7).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  LEFT
}

enum CostCenterSource {
  DMP
  MANUAL
}

/// EMPLOYEE is implicit for every active employee and is not stored.
enum AssignableRole {
  DEPT_ADMIN
  HC_ADMIN
  SYS_ADMIN
}

enum AuthMethod {
  PIN
  ENTRA
}

enum SyncType {
  ORG_EMPLOYEES
  ATTENDANCE
  LEAVE
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum MealSession {
  LUNCH
}

enum MenuWeekStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RegistrationStatus {
  ACTIVE
  NEEDS_RESELECT
  CANCELLED
}

enum RegistrationSource {
  SELF
  ADMIN
}

enum NotificationType {
  MENU_DISH_REPLACED
  MENU_DISH_REMOVED
}

enum MappingImportStatus {
  PREVIEW
  REJECTED
  APPLIED
}

model Factory {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  dmpCompanyCode String?
  timezone       String   @default("Asia/Ho_Chi_Minh")
  createdAt      DateTime @default(now())

  settings        Setting[]
  suppliers       Supplier[]
  canteens        Canteen[]
  floors          Floor[]
  costCenters     CostCenter[]
  orgUnits        OrgUnit[]
  roleAssignments RoleAssignment[]
  dishTypes       DishType[]
  dishes          Dish[]
  desserts        Dessert[]
  menuWeeks       MenuWeek[]
}

model Setting {
  id        String   @id @default(cuid())
  factoryId String
  key       String
  /// JSON value; shape is validated per key by packages/shared SETTING_DEFINITIONS.
  value     Json
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])

  @@unique([factoryId, key])
}

model Supplier {
  id        String  @id @default(cuid())
  factoryId String
  name      String
  unitPrice Decimal @db.Decimal(12, 2)
  active    Boolean @default(true)

  factory  Factory   @relation(fields: [factoryId], references: [id])
  canteens Canteen[]
}

/// Where meals are served; menus are built per canteen (BR-15). BR-62: never deleted.
model Canteen {
  id         String  @id @default(cuid())
  factoryId  String
  code       String
  name       String
  supplierId String
  active     Boolean @default(true)

  factory   Factory    @relation(fields: [factoryId], references: [id])
  supplier  Supplier   @relation(fields: [supplierId], references: [id])
  orgUnits  OrgUnit[]
  menuWeeks MenuWeek[]
  /// Each canteen has its own dish and dessert library (product owner, 2026-10-23).
  dishes    Dish[]
  desserts  Dessert[]

  @@unique([factoryId, code])
}

/// Delivery location of a meal unit's box. BR-62: never deleted.
model Floor {
  id        String  @id @default(cuid())
  factoryId String
  code      String
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  factory          Factory    @relation(fields: [factoryId], references: [id])
  orgUnits         OrgUnit[]
  /// Employees an HC admin moved to this floor to pick up their meal.
  floorOverrideFor Employee[] @relation("FloorOverride")

  @@unique([factoryId, code])
}

/// Accounting unit that bears an employee's meal cost. BR-62: never deleted.
model CostCenter {
  id        String           @id @default(cuid())
  factoryId String
  code      String
  name      String
  source    CostCenterSource @default(MANUAL)
  active    Boolean          @default(true)

  factory   Factory    @relation(fields: [factoryId], references: [id])
  orgUnits  OrgUnit[]
  employees Employee[] @relation("CostCenterOverride")

  @@unique([factoryId, code])
}

/// Node of the up-to-6-level org tree (BR-61). floorId / canteenId / costCenterId are nullable and
/// inherited from the nearest ancestor that has one (BR-62).
model OrgUnit {
  id                String   @id @default(cuid())
  factoryId         String
  dmpCode           String
  name              String
  /// 1..6 (BR-61)
  level             Int
  dmpLevelName      String
  parentId          String?
  /// Materialized path of ids: "/<rootId>/<id>/.../<thisId>/" (trailing slash), see rules/permissions.
  path              String
  isMealUnit        Boolean  @default(false)
  floorId           String?
  canteenId         String?
  costCenterId      String?
  /// Cost center code DMP reports for the node, if any (plan section 5; kept for reference, see
  /// open-questions Q9). Admin mapping lives in costCenterId.
  dmpCostCenterCode String?
  /// False when the node disappeared from DMP (never deleted).
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  factory    Factory     @relation(fields: [factoryId], references: [id])
  parent     OrgUnit?    @relation("OrgTree", fields: [parentId], references: [id])
  children   OrgUnit[]   @relation("OrgTree")
  floor      Floor?      @relation(fields: [floorId], references: [id])
  canteen    Canteen?    @relation(fields: [canteenId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  employees       Employee[]       @relation("EmployeeOrgUnit")
  mealUnitMembers Employee[]       @relation("EmployeeMealUnit")
  roleAssignments RoleAssignment[]

  @@unique([factoryId, dmpCode])
  @@index([parentId])
  @@index([path])
}

model Employee {
  id                   String         @id @default(cuid())
  /// DMP employeeId, normalized to employeeCode (plan section 5).
  employeeCode         String         @unique
  name                 String
  email                String?
  orgUnitId            String
  /// Nearest flagged ancestor-or-self (BR-60); recomputed on sync or flag change.
  mealUnitId           String?
  /// Where the employee picks up their meal when it is not their meal unit's floor, e.g. an IT
  /// employee of floor 3 who sits on floor 1 (product owner, 2026-10-23). Set by the HC admin.
  floorOverrideId      String?
  /// No longer read: cost center follows the org tree (product owner, 2026-10-23). Kept, never
  /// deleted (rule 7), so earlier overrides stay on record.
  costCenterOverrideId String?
  dmpCostCenterCode    String?
  status               EmployeeStatus @default(ACTIVE)
  startDate            DateTime?      @db.Date
  endDate              DateTime?      @db.Date
  pinHash              String?
  pinMustChange        Boolean        @default(true)
  pinFailedCount       Int            @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime       @default(now())

  orgUnit            OrgUnit          @relation("EmployeeOrgUnit", fields: [orgUnitId], references: [id])
  mealUnit           OrgUnit?         @relation("EmployeeMealUnit", fields: [mealUnitId], references: [id])
  floorOverride      Floor?           @relation("FloorOverride", fields: [floorOverrideId], references: [id])
  costCenterOverride CostCenter?      @relation("CostCenterOverride", fields: [costCenterOverrideId], references: [id])
  roleAssignments    RoleAssignment[]
  sessions           AuthSession[]
  auditLogs          AuditLog[]
  registrations      Registration[]
  forecastLines      ForecastLine[]
  notifications      Notification[]

  @@index([orgUnitId])
  @@index([mealUnitId])
  @@index([email])
}

model RoleAssignment {
  id         String         @id @default(cuid())
  employeeId String
  role       AssignableRole
  factoryId  String
  /// Only for DEPT_ADMIN: the org node (and its children) they manage.
  orgUnitId  String?
  createdAt  DateTime       @default(now())
  /// Revoked assignments are kept for the record (never deleted); only rows with null count.
  revokedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
  factory  Factory  @relation(fields: [factoryId], references: [id])
  orgUnit  OrgUnit? @relation(fields: [orgUnitId], references: [id])

  @@index([employeeId])
}

model AuthSession {
  id         String     @id @default(cuid())
  employeeId String
  /// SHA-256 of the opaque cookie token; the token itself is never stored.
  tokenHash  String     @unique
  /// How the user signed in; the forced PIN change only applies to PIN sessions.
  method     AuthMethod
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime   @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([expiresAt])
}

/// BR-70: who, when, before, after, reason. Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  /// Null for automatic system actions.
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  at         DateTime

  actor Employee? @relation(fields: [actorId], references: [id])

  @@index([at])
  @@index([actorId])
  @@index([entityType, entityId])
}

model SyncRun {
  id          String     @id @default(cuid())
  type        SyncType
  startedAt   DateTime
  finishedAt  DateTime?
  status      SyncStatus
  recordCount Int?
  error       String?
  /// Counts and warnings (e.g. employees skipped because their org node is unknown).
  details     Json?

  @@index([type, startedAt])
}

/// BR-10: dish types (Mặn, Chay, Cháo, Eat clean, ...), master data since 2026-10-23. Drawn in
/// `color` next to the dish name; `minPerDay` / `maxPerDay` are the usual mix (BR-13, warning
/// only). Deactivated, never deleted.
model DishType {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  /// #rrggbb
  color     String
  sortOrder Int      @default(0)
  minPerDay Int?
  maxPerDay Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  factory Factory @relation(fields: [factoryId], references: [id])
  dishes  Dish[]

  @@unique([factoryId, code])
}

/// BR-10: main-dish library of one canteen, reused across weeks; archived, never deleted.
/// The migration adds a unique index on (canteenId, typeId, lower(name)): no duplicate dishes.
model Dish {
  id         String        @id @default(cuid())
  factoryId  String
  canteenId  String
  name       String
  typeId     String
  sessions   MealSession[]
  archivedAt DateTime?
  createdAt  DateTime      @default(now())

  factory   Factory    @relation(fields: [factoryId], references: [id])
  canteen   Canteen    @relation(fields: [canteenId], references: [id])
  type      DishType   @relation(fields: [typeId], references: [id])
  menuItems MenuItem[]

  @@index([canteenId, typeId])
}

/// BR-10: dessert library of one canteen; display-only on a day (BR-11).
/// The migration adds a unique index on (canteenId, lower(name)).
model Dessert {
  id         String    @id @default(cuid())
  factoryId  String
  canteenId  String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  factory  Factory          @relation(fields: [factoryId], references: [id])
  canteen  Canteen          @relation(fields: [canteenId], references: [id])
  menuDays MenuDayDessert[]

  @@index([canteenId])
}

/// BR-15: one menu per canteen and week. closeAt is computed at publish (BR-03, BR-04).
model MenuWeek {
  id            String         @id @default(cuid())
  factoryId     String
  canteenId     String
  /// Monday of week N.
  weekStart     DateTime       @db.Date
  status        MenuWeekStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?
  closeAt       DateTime?
  /// Set by the close-week job when the forecast snapshot is taken (P2).
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  factory       Factory        @relation(fields: [factoryId], references: [id])
  canteen       Canteen        @relation(fields: [canteenId], references: [id])
  days          MenuDay[]
  forecastLines ForecastLine[]

  @@unique([canteenId, weekStart])
  @@index([factoryId, weekStart])
}

/// BR-08: Saturday is turned on per week; holidays are marked not served.
model MenuDay {
  id         String   @id @default(cuid())
  menuWeekId String
  date       DateTime @db.Date
  isServing  Boolean

  menuWeek MenuWeek         @relation(fields: [menuWeekId], references: [id])
  items    MenuItem[]
  desserts MenuDayDessert[]

  @@unique([menuWeekId, date])
}

/// One selectable meal. Removed or replaced items are kept with removedAt (BR-14, rule 7).
model MenuItem {
  id               String      @id @default(cuid())
  menuDayId        String
  session          MealSession @default(LUNCH)
  dishId           String
  sortOrder        Int
  removedAt        DateTime?
  /// BR-14: the item that replaced this one; its registrations moved there.
  replacedByItemId String?

  menuDay       MenuDay        @relation(fields: [menuDayId], references: [id])
  dish          Dish           @relation(fields: [dishId], references: [id])
  replacedBy    MenuItem?      @relation("MenuItemReplacement", fields: [replacedByItemId], references: [id])
  replaces      MenuItem[]     @relation("MenuItemReplacement")
  registrations Registration[]
  movedHere     Registration[] @relation("RegistrationReplacedFrom")
  forecastLines ForecastLine[]

  @@index([menuDayId])
}

model MenuDayDessert {
  id        String    @id @default(cuid())
  menuDayId String
  dessertId String
  sortOrder Int       @default(0)
  removedAt DateTime?

  menuDay MenuDay @relation(fields: [menuDayId], references: [id])
  dessert Dessert @relation(fields: [dessertId], references: [id])

  @@index([menuDayId])
}

/// BR-20: quantity per employee per menu item. Created in P1 only so BR-14 can move or flag
/// registrations when a published menu changes; the registration flows arrive in P2.
model Registration {
  id                 String             @id @default(cuid())
  employeeId         String
  menuItemId         String
  date               DateTime           @db.Date
  session            MealSession        @default(LUNCH)
  quantity           Int
  source             RegistrationSource
  isExtra            Boolean            @default(false)
  extraReason        String?
  status             RegistrationStatus @default(ACTIVE)
  /// BR-14: the item this meal was on before the HC admin replaced its dish. The employee sees a
  /// red note on the new dish when the replacement came after closeAt (2026-10-23).
  replacedFromItemId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  employee     Employee  @relation(fields: [employeeId], references: [id])
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id])
  replacedFrom MenuItem? @relation("RegistrationReplacedFrom", fields: [replacedFromItemId], references: [id])

  @@unique([employeeId, menuItemId])
  @@index([date, session])
}

/// BR-07 / BR-64: immutable forecast snapshot with the mapping in effect at closeAt. Write-once:
/// a database trigger rejects UPDATE and DELETE. Rows are written by the close-week job (P2).
model ForecastLine {
  id           String      @id @default(cuid())
  menuWeekId   String
  employeeId   String
  date         DateTime    @db.Date
  session      MealSession
  menuItemId   String
  quantity     Int
  mealUnitId   String?
  floorId      String?
  canteenId    String?
  costCenterId String?
  createdAt    DateTime    @default(now())

  menuWeek MenuWeek @relation(fields: [menuWeekId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([menuWeekId])
  @@index([date, session])
}

/// In-app notices (BR-14).
model Notification {
  id         String           @id @default(cuid())
  employeeId String
  type       NotificationType
  payload    Json
  readAt     DateTime?
  createdAt  DateTime

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, readAt])
}

/// BR-64: an uploaded mapping file. Validated into PREVIEW (or REJECTED), then applied all at once.
model MappingImport {
  id           String              @id @default(cuid())
  factoryId    String
  fileName     String
  uploadedById String
  status       MappingImportStatus
  rowCount     Int
  errorCount   Int
  /// Parsed rows (PREVIEW) or row-level errors (REJECTED).
  rows         Json
  errors       Json
  createdAt    DateTime
  appliedAt    DateTime?
}
